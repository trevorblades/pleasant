---
import { SiInstagram } from "@icons-pack/react-simple-icons";

import Logo from "~/assets/logo.svg";
import Layout from "~/layouts/Layout.astro";
---

<script>
  import { animate, inView, stagger } from "motion";

  inView(
    "[data-animateclass='container']",
    (element) => {
      const logo = element.querySelector("[data-animateclass='logo']");
      const text = element.querySelector("[data-animateclass='text']");
      const elements = [logo, text];

      if (elements.length > 0) {
        animate(
          elements,
          { opacity: [0, 1] },
          {
            type: "tween",
            duration: 1.5,
            delay: stagger(0.25, { startDelay: 0.25 }),
          },
        );
        animate(
          [logo],
          { y: [5, 0] },
          {
            type: "tween",
            duration: 1,
            delay: stagger(0.5, { startDelay: 0.5 }),
            repeat: Infinity,
            repeatType: "mirror",
          },
        );
      }
    },
    { amount: 0.25 },
  );
</script>

<Layout>
  <div class="flex min-h-screen bg-lilac-300" data-animateclass="container">
    <div class="m-auto space-y-8 p-8 text-center">
      <Logo class="mx-auto size-40" data-animateclass="logo" />
      <div class="space-y-6" data-animateclass="text">
        <p class="text-4xl">
          Something <span class="font-display font-bold tracking-tighter italic"
            >pleasant</span
          > is brewing...
        </p>
        <a
          class="btn"
          target="_blank"
          href="https://instagram.com/pleasantcoffee.ca"
        >
          <SiInstagram className="size-5 fill-current" />
          Follow us for updates
        </a>
      </div>
    </div>
  </div>
</Layout>
