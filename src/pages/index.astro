---
import Logo from "~/assets/logo.svg";
import Layout from "~/layouts/Layout.astro";
---

<Layout>
  <div class="flex min-h-screen bg-lilac-300">
    <div class="m-auto space-y-10 text-center">
      <Logo class="mx-auto size-60" />
      <div class="space-y-4">
        <div class="space-y-4 text-5xl">
          <p>
            Something <span class="font-display tracking-tighter">pleasant</span
            > is brewing in Port Moody...
          </p>
          <p>
            <a
              class="not-hover:underline"
              href="https://instagram.com/pleasantcoffee.ca"
              >Follow us on Instagram</a
            > for updates.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
