---
import { SiInstagram } from "@icons-pack/react-simple-icons";

import Logo from "~/assets/logo.svg";
import Layout from "~/layouts/Layout.astro";
---

<Layout>
  <div class="flex min-h-screen bg-lilac-300">
    <div class="m-auto space-y-8 p-8 text-center">
      <div
        class={`
          motion-opacity-in-0 motion-ease-spring-smooth motion-delay-250
          motion-duration-1500
        `}
      >
        <Logo
          class={`
            mx-auto size-40 motion-translate-y-loop-[5px]
            motion-ease-in-out-quad motion-duration-2000
          `}
        />
      </div>
      <div
        class={`
          motion-opacity-in-0 space-y-6 motion-ease-spring-smooth
          motion-delay-500 motion-duration-1500
        `}
      >
        <p class="text-4xl">
          Something <span class="font-display font-bold tracking-tighter italic"
            >pleasant</span
          > is brewing...
        </p>
        <a
          class="btn"
          target="_blank"
          href="https://instagram.com/pleasantcoffee.ca"
        >
          <SiInstagram className="size-5 fill-current" />
          Follow us for updates
        </a>
      </div>
    </div>
  </div>
</Layout>
