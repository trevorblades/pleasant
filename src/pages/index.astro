---
import { SiInstagram } from "@icons-pack/react-simple-icons";

import Logo from "~/assets/logo.svg";
import Layout from "~/layouts/Layout.astro";
---

<Layout>
  <div class="flex min-h-screen bg-lilac-300">
    <div class="m-auto space-y-8 p-8 text-center">
      <Logo class="mx-auto size-40" />
      <div class="space-y-6">
        <p class="text-4xl">
          Something <span class="font-display tracking-tighter">pleasant</span> is
          brewing...
        </p>
        <a
          class="btn"
          target="_blank"
          href="https://instagram.com/pleasantcoffee.ca"
        >
          <SiInstagram className="size-5 fill-current" />
          Follow us for updates
        </a>
      </div>
    </div>
  </div>
</Layout>
